model AdminAuditLog {
    id          String   @id @default(uuid())

    adminEmail  String
    action      String
    entityType  String?
    entityId    String?
    entityLabel String? // human-readable label (email, title, etc)
    description String // REQUIRED now
    metadata    Json?
    ipAddress   String?
    userAgent   String?
    createdAt   DateTime @default(now())

    adminId     String
    admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

    @@index([adminId])
    @@index([entityType])
}
