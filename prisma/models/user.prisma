model User {
    id String @id @default(uuid())

    firstName String
    lastName  String

    email       String @unique
    phoneNumber String @unique
    userName    String @unique
    usernameChangedAt DateTime?

    password    String

    wallet      Wallet?
    orders      Order[]
    tickets     SupportTicket[]
    notifications Notification[]

    // Referrals & Affiliate System
    referralCode            String?          @unique
    referredById            String?
    referredBy              User?            @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
    referrals               User[]           @relation("UserReferrals")
    referralEarnings        Decimal          @default(0) @db.Decimal(14, 2)
    referralRewardsReceived ReferralReward[] @relation("ReferrerRewards")
    referralRewardsGiven    ReferralReward[] @relation("RefereeRewards")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([email])
    @@index([userName])
    @@index([phoneNumber])
    @@index([referralCode])
    @@index([referredById])
}
