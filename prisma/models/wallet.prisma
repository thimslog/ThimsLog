model Wallet {
  id        String   @id @default(uuid())

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  
  balance   Decimal  @default(0) @db.Decimal(14, 2) // never use Float for money
  currency  String   @default("NGN")
  paymonetraCustomer String?  @unique // their permanent customer_reference, e.g. "wallet_<userId>"

  // Virtual Account fields
  bankName                 String?
  accountNumber            String?
  accountName              String?
  virtualAccountReference  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}